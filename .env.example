# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore. NUNCA commitees secretos reales.
# Mantener este archivo sincronizado en cada cambio (CLAUDE.md §9).

# --- Supabase -------------------------------------------------------------
# Públicas: viajan al bundle del cliente.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salta RLS. SOLO servidor, jamás en cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Landing externa de pago ---------------------------------------------
# Ojo con la ortografía del dominio: pendiente de confirmar con el cliente
# (CLAUDE.md §3). Nunca hardcodear el dominio en el código.
NEXT_PUBLIC_LANDING_URL=https://abundancecode.com

# --- Stripe ---------------------------------------------------------------
# Esta app NO cobra: solo webhook + portal de facturación.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IA -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Fallback opcional.
OPENAI_API_KEY=

# --- Geocoding ------------------------------------------------------------
# Autocomplete de ciudades + zona horaria. Proveedor pendiente de decidir.
GEOCODING_API_KEY=

# --- Plan B de acceso -----------------------------------------------------
# HMAC compartido con la landing. Solo si NO controlamos el webhook de Stripe.
ACCESS_SHARED_SECRET=
