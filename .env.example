# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore. NUNCA commitees secretos reales.
# Mantener este archivo sincronizado en cada cambio (CLAUDE.md §9).

# --- Supabase -------------------------------------------------------------
# Públicas: viajan al bundle del cliente.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salta RLS. SOLO servidor, jamás en cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Landing externa de pago ---------------------------------------------
# CONFIRMADO por el cliente: el dominio va SIN la "n" (abundacecode.com).
# No es una errata nuestra. Nunca hardcodear el dominio en el código.
NEXT_PUBLIC_LANDING_URL=https://abundacecode.com

# --- Backend de la landing ------------------------------------------------
# Quien cobra es la landing, así que quien sabe quién ha pagado es la landing.
# El contrato entre los dos equipos (BRIEF-APP-INTEGRACION.md) es explícito:
# «La app no cobra nada. No necesita Stripe, ni claves, ni webhooks. Sólo
#  pregunta al backend de la web quién ha pagado.»
#
# URL pública de su Express. Pendiente de que la pasen tras su redespliegue.
LANDING_API_URL=

# Secreto compartido para /api/access/redeem y /status. Va en la cabecera
# Authorization: Bearer. NUNCA en el navegador: sus llamadas son servidor a
# servidor y su CORS solo acepta peticiones desde su propio dominio.
APP_SHARED_SECRET=

# --- Stripe ---------------------------------------------------------------
# OBSOLETAS desde que el acceso se resuelve contra la landing. Se conservan
# mientras el webhook propio siga en el repo, apagado. Esta app no necesita
# ninguna clave de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IA -------------------------------------------------------------------
# Proveedor principal: OpenAI, por decisión del cliente (julio 2026). Ojo: una
# suscripción a ChatGPT NO paga el uso de la API, se factura aparte.
OPENAI_API_KEY=
# Alternativa. El proyecto usa el AI SDK, así que cambiar de proveedor es
# sustituir el modelo, no reescribir las llamadas.
ANTHROPIC_API_KEY=

# --- Geocoding ------------------------------------------------------------
# Proveedor: GeoNames (gratuito y permite almacenar los resultados, que es
# justo lo que hacemos al guardarlos en `portals`).
#
# Aquí va el NOMBRE DE USUARIO de GeoNames, no una clave: es lo que ese
# servicio usa para identificar la cuenta. Se obtiene registrándose gratis en
# https://www.geonames.org/login y activando después el acceso a los servicios
# web desde el correo de confirmación.
GEOCODING_API_KEY=

# --- Producción -----------------------------------------------------------
# Solo la exige `npm run check:produccion`. Es una confirmación humana, no un
# secreto: declara que se ha decidido sobre qué proyecto de Supabase corre
# producción. Hoy el que hay es `abundance-code-dev`, bajo una cuenta
# institucional que caduca (ver docs/despliegue.md §0.1).
SUPABASE_PROYECTO_CONFIRMADO=

# --- Plan B de acceso -----------------------------------------------------
# HMAC compartido con la landing. Solo si NO controlamos el webhook de Stripe.
ACCESS_SHARED_SECRET=
